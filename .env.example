# ===============================
# APPLICATION
# ===============================
NODE_ENV=development

# ===============================
# DATABASE
# ===============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinic_management
DB_USER=root
DB_PASSWORD=

# ===============================
# AUTH / JWT
# ===============================
JWT_SECRET=CLINIC_MGMT_2025@JWT&9fA3x!Qz$Lm8Kp
JWT_EXPIRES_IN=7d

# ===============================
# FILE UPLOADS
# ===============================
UPLOAD_PATH=public/uploads

# ===============================
# SERVICES PORTS
# ===============================
PORT=3000
AUTH_SERVICE_PORT=4000
CLINIC_SERVICE_PORT=4001
PATIENT_SERVICE_PORT=4002
LAB_SERVICE_PORT=4003
ADMIN_SERVICE_PORT=4004

# ===============================
# SMS GATEWAY
# ===============================
# Set SMS_PROVIDER to one of: msg91 | fast2sms | twilio | textlocal | console
# Use "console" for development (OTP printed to terminal, no real SMS sent)
SMS_PROVIDER=console

# OTP message template — use {otp} as placeholder
SMS_MESSAGE_TEMPLATE=Your OTP for Clinic Registration is {otp}. Valid for 10 minutes. Do not share.

# ── MSG91 (https://msg91.com) ──────────────────────────────────────
# Get authkey from: MSG91 Dashboard > API > Authkey
SMS_MSG91_AUTHKEY=your_msg91_authkey_here
SMS_MSG91_TEMPLATE_ID=your_msg91_template_id_here
SMS_MSG91_SENDER_ID=CLINIC

# ── Fast2SMS (https://www.fast2sms.com) ───────────────────────────
# Get API key from: Fast2SMS Dashboard > Dev API
SMS_FAST2SMS_APIKEY=your_fast2sms_apikey_here
SMS_FAST2SMS_SENDER_ID=CLINIC
SMS_FAST2SMS_MESSAGE=Your OTP for Clinic Registration is {otp}. Valid for 10 minutes. Do not share.

# ── Twilio (https://www.twilio.com) ───────────────────────────────
# Get from: Twilio Console > Account Info
SMS_TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
SMS_TWILIO_FROM=+1xxxxxxxxxx

# ── Text Local (https://www.textlocal.in) ─────────────────────────
# Get API key from: TextLocal Dashboard > Settings > API Keys
SMS_TEXTLOCAL_APIKEY=your_textlocal_apikey_here
SMS_TEXTLOCAL_SENDER=CLINIC
