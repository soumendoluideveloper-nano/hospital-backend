{
  "name": "clinic-management-system",
  "version": "1.0.0",
  "description": "Clinic Management System - Microservice Architecture (Node.js + MySQL + Sequelize)",
  "private": true,
  "scripts": {
    "start:gateway":  "node server.js",
    "start:auth":     "node services/auth-service/server.js",
    "start:clinic":   "node services/clinic-service/server.js",
    "start:patient":  "node services/patient-service/server.js",
    "start:lab":      "node services/lab-service/server.js",
    "start:admin":    "node services/admin-service/server.js",
    "dev:gateway":    "nodemon server.js",
    "dev:auth":       "nodemon services/auth-service/server.js",
    "dev:clinic":     "nodemon services/clinic-service/server.js",
    "dev:patient":    "nodemon services/patient-service/server.js",
    "dev:lab":        "nodemon services/lab-service/server.js",
    "dev:admin":      "nodemon services/admin-service/server.js",
    "start": "npm-run-all --parallel start:auth start:clinic start:patient start:lab start:admin start:gateway",
    "dev":        "npm-run-all --parallel dev:auth dev:clinic dev:patient dev:lab dev:admin dev:gateway",
    "seed:admin": "node scripts/seed.admin.js"
  },
  "dependencies": {
    "bcryptjs":             "^2.4.3",
    "body-parser":          "^2.2.1",
    "cookie-parser":        "^1.4.7",
    "cors":                 "^2.8.5",
    "dotenv":               "^17.2.3",
    "express":              "^4.18.2",
    "http-proxy-middleware": "^3.0.5",
    "joi":                  "^18.0.2",
    "jsonwebtoken":         "^9.0.2",
    "multer":               "^2.0.2",
    "mysql2":               "^3.9.7",
    "nodemon":              "^3.1.11",
    "sequelize":            "^6.37.3",
    "swagger-autogen":      "^2.23.7",
    "swagger-ui-express":   "^5.0.1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
